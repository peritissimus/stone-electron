# Stone server configuration.
#
# Copy to .env for a local run. The format is also what systemd's
# EnvironmentFile= and docker's --env-file expect, so the same file can
# configure a deployed instance.
#
# Every value below is a default — the server starts with none of them set.

# --- Network -----------------------------------------------------------------

# There is NO authentication in front of the API. Loopback is the only thing
# separating a reader from every note and every AI key in this workspace. Bind
# beyond it solely behind a private network or an authenticating reverse proxy.
STONE_HOST=127.0.0.1
STONE_PORT=3000

# --- Data --------------------------------------------------------------------

# Root for everything else that is not set explicitly.
STONE_DATA_DIR=./data

# Notes on disk, as markdown. This is the source of truth; the database is an
# index over it.
STONE_WORKSPACE_PATH=./data/workspace

# libsql/sqlite file.
DATABASE_URL=./data/notes.db

# Typed user preferences (editor, shortcuts, AI providers).
STONE_CONFIG_PATH=./data/config.json

# --- Build outputs -----------------------------------------------------------
#
# Defaults assume `pnpm build:web-stack` was run from the repo root. Point these
# at absolute paths when the process runs from elsewhere.

# Static frontend. Absent, the server runs API-only.
STONE_WEB_DIST=./dist/web

# Embedding worker. Absent, semantic search cannot start.
STONE_EMBEDDING_WORKER=./dist/main/workers/embedding.worker.cjs

# --- Models ------------------------------------------------------------------

# Shared with the desktop app when both point at the same config directory, so
# the embedding model downloads at most once.
STONE_ML_CACHE_DIR=./data/ml-cache

# GGML transcription models, fetched on first use.
STONE_WHISPER_MODEL_DIR=./data/whisper-models

# whisper.cpp binaries, from `pnpm build:whisper`. Both are found relative to
# the packaged app by default; set them when running unpackaged.
# STONE_WHISPER_BINARY=./vendor/whisper/bin/whisper-cli
# STONE_WHISPER_SERVER_BINARY=./vendor/whisper/bin/whisper-server

# --- Secrets -----------------------------------------------------------------

# Encrypts stored AI provider keys at rest, standing in for the OS keychain the
# desktop app uses. Unset, the key file falls back to file permissions alone.
# Generate with: openssl rand -hex 32
# STONE_SECRET_KEY=

# --- Diagnostics -------------------------------------------------------------

# error | warn | info | debug. Successful operations log at debug, so raise it
# to trace a request end to end.
# STONE_LOG_LEVEL=info
