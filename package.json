{
  "name": "stone",
  "version": "0.8.7",
  "description": "Production-ready note-taking desktop application",
  "main": "./dist/main/index.cjs",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "author": "peritissimus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/peritissimus/stone-electron.git"
  },
  "homepage": "https://github.com/peritissimus/stone-electron#readme",
  "bugs": {
    "url": "https://github.com/peritissimus/stone-electron/issues"
  },
  "scripts": {
    "dev": "pnpm run build:dev-runtime && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:calendar-bridge": "node scripts/build-calendar-bridge.cjs",
    "build:dev-runtime": "pnpm run build:calendar-bridge && pnpm run build:main && pnpm run build:worker && pnpm run build:preload",
    "build": "pnpm run build:calendar-bridge && pnpm run build:main && pnpm run build:worker && pnpm run build:preload && pnpm run build:renderer",
    "build:worker": "vite build --config vite.worker.config.ts",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "build:web-stack": "pnpm run build:server && pnpm run build:web",
    "start": "electron .",
    "preview": "vite preview",
    "package": "pnpm run build:whisper && electron-builder",
    "package:dir": "pnpm run build:whisper && electron-builder --dir",
    "package:all": "pnpm run build:whisper && electron-builder -mwl",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage run",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:ui": "pnpm run build && playwright test --ui",
    "test:e2e:headed": "pnpm run build && playwright test --headed",
    "test:e2e:nobuild": "playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "sonar": "vitest run --coverage && sonar-scanner",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "fs:check": "tsx -r tsconfig-paths/register scripts/fs-sync-check.ts",
    "fs:scan": "tsx scripts/fs-scan-only.ts",
    "server": "tsx src/main/infrastructure/server/standalone.ts",
    "server:dev": "tsx watch src/main/infrastructure/server/standalone.ts",
    "web:dev": "vite --config vite.web.config.ts",
    "web:dev-stack": "concurrently -k \"pnpm run server:dev\" \"pnpm run web:dev\"",
    "web:start": "node dist/server/standalone.mjs",
    "release": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build:whisper": "./scripts/build-whisper.sh"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@libsql/client": "^0.15.15",
    "@xenova/transformers": "^2.6.5",
    "chokidar": "^4.0.3",
    "effect": "^3.22.0",
    "electron-log": "^5.4.4",
    "fastify": "^5.10.0",
    "font-list": "^2.1.0",
    "glob": "^13.0.6",
