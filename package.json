    "lucide-react": "^0.548.0",
    "markdown-it": "^14.3.0",
    "mermaid": "^11.16.0",
    "prettier": "^3.9.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph-2d": "^1.29.1",
    "react-router-dom": "^7.18.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^4.3.2",
    "tippy.js": "^6.3.7",
    "tsx": "^4.23.1",
    "turndown": "^7.2.4",
